DATABASE_URL=sqlite:///./pahunch.db
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE=indic-auto
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_TTS_LANGUAGE=hi-en
GNANI_TIMEOUT_SECONDS=30
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=12
LLM_MAX_TOKENS=320
LLM_TEMPERATURE=0.1
LLM_STRUCTURED_MODE=json_schema
LLM_ENABLE_THINKING=false
PLANNER_MIN_CONFIDENCE=0.65
PLANNER_MIN_TRANSCRIPT_CONFIDENCE=0.55
REALTIME_SAMPLE_RATE=16000
REALTIME_VAD_THRESHOLD=500
REALTIME_SILENCE_MS=600
REALTIME_MAX_UTTERANCE_MS=15000
REALTIME_MIN_SPEECH_MS=300
STREAMING_STT_ENABLED=true
STREAMING_STT_CANDIDATES=hi-IN,en-IN
STREAMING_STT_TRANSCRIPT_TIMEOUT_SECONDS=3
REALTIME_QUIET_MS=600
REALTIME_ADAPTIVE_VAD=true
REALTIME_VAD_FLOOR=120
REALTIME_VAD_CEILING=12000
REALTIME_NOISE_RATIO=3.0
REALTIME_CALIBRATION_MS=300
REALTIME_SPEECH_START_MS=100
REALTIME_BARGE_IN_MS=160
REALTIME_PRE_ROLL_MS=200
REALTIME_NO_SPEECH_MS=5000

# Local browser scheduling only; no telephone provider request is made.
DIALER_ENABLED=true
DIALER_INTERVAL_SECONDS=5
DIALER_WAITING_TIMEOUT_SECONDS=120
DIALER_DISCONNECT_GRACE_SECONDS=30
DIALER_IDLE_TIMEOUT_SECONDS=300

# --- Real phone calls (optional) ---------------------------------------------
# Leave TELEPHONY_PROVIDER=none to keep using the browser as the phone.
# This file is a template and is committed to git: put real values in .env only.
TELEPHONY_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number the call comes FROM, in E.164 form (for example +1...).
TWILIO_FROM_NUMBER=
# Public https:// address Twilio can reach, for example a Cloudflare or ngrok tunnel
# pointing at this server. No trailing slash.
PUBLIC_BASE_URL=
# YOUR OWN phone in E.164 form (+91...). The dialer may only ever call this number.
DEMO_HANDSET_NUMBER=
# Verification must be completed before any real dispatch. Keep false while pending.
TWILIO_CONSOLE_VERIFIED=false
TWILIO_STREAMING_VERIFIED=false
GNANI_PHONE_DEMO_APPROVED=false
# Set only after approval for one existing local session. A retry needs new approval.
TWILIO_APPROVED_SESSION_ID=
